{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de la Biblioteca Escolar (Trabajo Integrador)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "test": "node --env-file-if-exists=.env --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  }
}
