# Copiá este archivo como .env y completá los valores.

# Puerto local y dirección pública de la API (sin barra al final).
PORT=3002
PUBLIC_URL=http://localhost:3002

# MySQL. Con XAMPP: usuario root sin contraseña.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca
# true para bases en la nube que exigen conexión cifrada.
DB_SSL=false
DB_SSL_CA=

# Claves para firmar los JWT: textos largos y aleatorios, distintos entre sí.
JWT_ACCESS_SECRET=cambiar-por-un-texto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambiar-por-otro-texto-largo-y-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

# Credenciales de las redes sociales (opcionales: si faltan, ese botón no aparece).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Direcciones de la app permitidas para volver del login social.
APP_REDIRECTS=biblioteca://,exp://
